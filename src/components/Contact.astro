---
interface CTA { label: string; href: string; primary?: boolean; }
interface FormCfg { enabled?: boolean; title?: string; subtitle?: string; }

interface Props {
  kicker: string;
  title: string;            // HTML allowed (<span class="strike">…</span>)
  email: string;
  sub?: string;
  cta?: CTA;                // legacy single CTA (still supported)
  ctas?: CTA[];             // new multi-CTA list
  form?: FormCfg;
}
const { kicker, title, email, sub, cta, ctas, form } = Astro.props;

const ctaList: CTA[] = ctas && ctas.length > 0 ? ctas : (cta ? [{ ...cta, primary: true }] : []);
const showForm = form?.enabled === true;
---

<section class="contact" id="contact">
  <div class="contact__kicker reveal">{kicker}</div>
  <h2 class="contact__title reveal" set:html={title}></h2>

  <a class="contact__email" href={`mailto:${email}`}>{email}</a>
  {sub && <p class="contact__sub">{sub}</p>}

  {ctaList.length > 0 && (
    <div class="contact__ctas reveal">
      {ctaList.map((c) => (
        <a class={`contact__cta ${c.primary ? 'contact__cta--primary' : 'contact__cta--ghost'}`} href={c.href}>
          {c.label}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      ))}
    </div>
  )}

  {showForm && (
    <div class="brief" id="brief">
      <div class="brief__head">
        <div class="section__label">Brief form</div>
        <h3 class="brief__title">{form?.title ?? "Send a brief."}</h3>
        {form?.subtitle && <p class="brief__sub">{form.subtitle}</p>}
      </div>

      <form
        class="brief__form"
        name="brief"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <input type="hidden" name="form-name" value="brief" />
        <p class="brief__honey" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="brief__grid">
          <label class="brief__field">
            <span>Name *</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="brief__field">
            <span>Company</span>
            <input type="text" name="company" autocomplete="organization" />
          </label>
          <label class="brief__field">
            <span>Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label class="brief__field">
            <span>Project type</span>
            <select name="projectType">
              <option value="">Pick one…</option>
              <option>AI Film Production</option>
              <option>AI Image Campaign</option>
              <option>Look Dev / Pitch Film</option>
              <option>Hybrid Production / VFX</option>
              <option>Custom AI Pipeline</option>
              <option>Other</option>
            </select>
          </label>
          <label class="brief__field">
            <span>Budget range</span>
            <select name="budget">
              <option value="">Pick one…</option>
              <option>&lt; 10k €</option>
              <option>10–30k €</option>
              <option>30–100k €</option>
              <option>100–300k €</option>
              <option>300k €+</option>
              <option>To discuss</option>
            </select>
          </label>
          <label class="brief__field">
            <span>Timeline</span>
            <select name="timeline">
              <option value="">Pick one…</option>
              <option>ASAP</option>
              <option>Within a month</option>
              <option>1–3 months</option>
              <option>3–6 months</option>
              <option>Exploratory</option>
            </select>
          </label>
        </div>

        <label class="brief__field brief__field--full">
          <span>Message *</span>
          <textarea name="message" required rows="5" placeholder="A few lines about the brief — references, audience, deliverables…"></textarea>
        </label>

        <button class="brief__submit" type="submit">
          Send brief
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </button>

        <p class="brief__legal">By submitting you accept that we may reply to your email about this project. We don't share your data.</p>
      </form>
    </div>
  )}
</section>
