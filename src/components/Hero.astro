---
interface Props {
  wordmark: string;
  tagline: string;
  desc: string;
  cta: { label: string; href: string };
  meta?: { location?: string; status?: string };
}

const { wordmark, tagline, desc, cta, meta } = Astro.props;

// Split wordmark into letters, marking R letters to get the acid accent
const letters = wordmark.split('').map((ch) => ({
  ch,
  acid: ch.toUpperCase() === 'R'
}));
---

<section class="hero" id="top">
  <video
    class="hero__bg"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/films/showreel-moodwalkrs-poster.jpg"
    aria-hidden="true"
  >
    <source src="/films/showreel-moodwalkrs-bg.mp4" type="video/mp4" />
  </video>
  <div class="hero__bg-overlay" aria-hidden="true"></div>

  <div class="hero__meta">
    <span>{meta?.location ?? ''}</span>
    <span>{meta?.status ?? ''} <span class="blink">●</span></span>
  </div>

  <div class="reel-chip" aria-hidden="true">
    <svg viewBox="0 0 100 100">
      <defs>
        <path id="circle" d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0"/>
      </defs>
      <text fill="#8A8880" font-family="JetBrains Mono" font-size="8" letter-spacing="2">
        <textPath href="#circle">REEL ·2026 · WATCH · REEL ·2026 · WATCH · </textPath>
      </text>
    </svg>
    <div class="play"></div>
  </div>

  <h1 class="hero__wordmark" aria-label={`${wordmark} — AI Creative Studio in Paris`}>
    {letters.map((l) => (
      <span class={l.acid ? 'r' : ''}>{l.ch}</span>
    ))}
  </h1>

  <!-- SR-only SEO line: visible to search engines and screen readers,
       invisible to sighted users (the wordmark and tagline carry it visually). -->
  <p class="sr-only">
    Moodwalkrs is a collective AI creative studio based in Paris, France — a studio IA
    that helps ideas become films. We deliver MOODFILM (AI moodfilms, pitch films, animatics
    and AI storyboards), AI film production, AI image campaigns and hybrid AI &amp; live-action
    production with VFX finishing — commercials, music videos, fashion films, brand films,
    documentaries — for brands, agencies and productions worldwide. Rights anticipated from day one.
  </p>

  <div class="hero__bottom">
    <h2 class="hero__tagline" set:html={tagline}></h2>
  </div>
</section>
