---
interface Item {
  num: string;
  title: string;
  desc: string;
  /** Optional link — when set, the card becomes clickable. */
  href?: string;
  /** Optional ambient looping video that plays muted behind the card. */
  video?: string;
  /** Optional poster (used as the still fallback for the video). */
  poster?: string;
}
interface Props {
  label: string;
  title: string;
  rightMeta?: string;
  items: Item[];
}
const { label, title, rightMeta, items } = Astro.props;
---

<section class="section" id="services">
  <div class="section__head reveal">
    <div>
      <div class="section__label">{label}</div>
      <h2 class="section__title" set:html={title}></h2>
    </div>
    {rightMeta && <div class="section__right">{rightMeta}</div>}
  </div>

  <div class="caps reveal-stagger">
    {items.map((it) => {
      const cardClass = `cap${it.video ? ' cap--has-video' : ''}${it.href ? ' cap--link' : ''}`;
      const inner = (
        <>
          {it.video && (
            <video
              class="cap__bg"
              src={it.video}
              poster={it.poster}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
            ></video>
          )}
          {it.video && <div class="cap__bg-overlay" aria-hidden="true"></div>}

          <div class="cap__num">{it.num}</div>
          <div class="cap__content">
            <h3 class="cap__title">{it.title}</h3>
            <p class="cap__desc">{it.desc}</p>
          </div>
          <div class="cap__arrow">↗</div>
        </>
      );
      return it.href ? (
        <a class={cardClass} href={it.href}>{inner}</a>
      ) : (
        <div class={cardClass}>{inner}</div>
      );
    })}
  </div>
</section>
