---
import BaseLayout from '../layouts/BaseLayout.astro';

// === JSON-LD Service schema — helps Google rank "moodfilm IA" / "AI moodfilm" ===
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "MOODFILM",
  "alternateName": ["AI moodfilm", "moodfilm IA", "AI pitch film", "AI look development"],
  "serviceType": "AI-driven look development & pitch films",
  "description": "MOODFILM is the Moodwalkrs format for AI-driven look development and pitch films — moodfilms, animatics, AI storyboards and treatment visuals. Built to convince before you produce.",
  "provider": {
    "@type": "Organization",
    "name": "Moodwalkrs",
    "url": "https://www.moodwalkrs.com",
    "address": { "@type": "PostalAddress", "addressLocality": "Paris", "addressCountry": "FR" }
  },
  "areaServed": "Worldwide",
  "category": ["AI Film Production", "Pitch Films", "Mood Films", "Look Development", "AI Storyboards"],
  "audience": {
    "@type": "Audience",
    "audienceType": "Agencies, brands, artists, production companies, luxury & fashion"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "description": "AI moodfilms with rights anticipated from day one. Same partner from pitch to broadcast-ready film."
  }
};
---

<BaseLayout
  title="MOODFILM — AI moodfilm, look dev & pitch films · Moodwalkrs Paris"
  description="MOODFILM is the Moodwalkrs format for AI moodfilms, animatics, AI storyboards, look development and treatment visuals. Sell the idea before you sell the production. AI creative studio · Paris."
  keywords="moodfilm, moodfilm IA, moodfilm AI, AI moodfilm, mood film IA, mood film AI, pitch film AI, AI pitch film, AI animatic, AI storyboard, look dev IA, treatment film, AI creative studio, Moodwalkrs, studio IA Paris"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <article class="moodfilm-page">

    <!-- ===================== INTRO ===================== -->
    <header class="mf-intro">
      <div class="section__label">[ MOODFILM · Look dev &amp; pitch films ]</div>
      <h1 class="mf-intro__title">MOODFILM<span class="punct">.</span></h1>
      <div class="mf-intro__body">
        <p class="mf-intro__lead">
          <strong>MOODFILM</strong> is the Moodwalkrs format for look development and pitch films — AI-driven moodfilms, animatics, treatment visuals and AI storyboards. Built to convince before you produce.
        </p>
        <p class="mf-intro__sub">
          From a brief, we generate a moodfilm that captures tone, pace and intention. When the project moves into production, the same creative team carries it through — combining AI, live action, craft and post-production whenever needed, with rights anticipated from day one.
        </p>
      </div>
    </header>

    <!-- ===================== CASE STUDY 01 — SAUDI ===================== -->
    <section class="mf-case">
      <div class="mf-case__head">
        <div class="section__label">[ Case study 01 · BETC ]</div>
        <h2 class="mf-case__title">Saudi — Not Madness.</h2>
        <p class="mf-case__lead">
          Director's cut commissioned by BETC. A moodfilm-first project that travelled from look-dev to a polished hybrid piece — without changing partner along the way.
        </p>
      </div>

      <!-- THE BRIEF -->
      <div class="mf-block">
        <div class="mf-block__label">01 · The brief we received</div>
        <figure class="mf-block__media">
          <img src="/case-study/saudi-betc/treatment.jpg" alt="Saudi — Not Madness — brief and treatment by BETC" loading="lazy" />
        </figure>
        <p class="mf-block__copy">
          A strategic and emotional document. Tone signals, references, audience notes — but no images yet. The objective: turn this brief into a viewing experience that fixes intention before the production line spins up.
        </p>
      </div>

      <!-- THE MOODFILM (3 clips) -->
      <div class="mf-block mf-block--clips">
        <div class="mf-block__label">02 · From brief to film — three signals</div>

        <div class="mf-clips">
          <figure class="mf-clip">
            <div class="mf-clip__num">01 · Opening</div>
            <video src="/case-study/saudi-betc/clip-brief.mp4" muted loop playsinline autoplay preload="metadata"></video>
            <figcaption>The first frames of the moodfilm. Tone and palette are settled here — every later decision references this opening.</figcaption>
          </figure>

          <figure class="mf-clip">
            <div class="mf-clip__num">02 · Mood</div>
            <video src="/case-study/saudi-betc/clip-mood.mp4" muted loop playsinline autoplay preload="metadata"></video>
            <figcaption>The piece breathes. Pace, lensing rhythm and color thicken. The viewer feels the intention before any line of dialogue lands.</figcaption>
          </figure>

          <figure class="mf-clip">
            <div class="mf-clip__num">03 · Body of the film</div>
            <video src="/case-study/saudi-betc/clip-film.mp4" muted loop playsinline autoplay preload="metadata"></video>
            <figcaption>The body — where the film carries its weight. AI imagery, live-action grammar and post are now one continuous language.</figcaption>
          </figure>
        </div>
      </div>

      <!-- CREDITS + BODY TEXT -->
      <div class="mf-block mf-block--credits">
        <dl class="mf-credits">
          <div><dt>Client</dt><dd>BETC · Saudi</dd></div>
          <div><dt>Format</dt><dd>Director's cut · Hybrid</dd></div>
          <div><dt>Workflow</dt><dd>Brief → Moodfilm → Shoot → AI / VFX → Finishing</dd></div>
          <div><dt>Year</dt><dd>2026</dd></div>
        </dl>
        <p class="mf-block__copy">
          The moodfilm fixed tone and pace early, so the live-action shoot could chase intention rather than discover it on set. Post combined AI layers, VFX and grading inside a single creative conversation — and rights were cleared from day one. Same partner, brief to broadcast.
        </p>
      </div>
    </section>

    <!-- ===================== CTA ===================== -->
    <section class="mf-cta">
      <h2 class="mf-cta__title">Have a brief? <em>Start a moodfilm.</em></h2>
      <p class="mf-cta__sub">A moodfilm in 7–14 days. After that, you decide — ship it as a pitch piece or keep going to a broadcast-ready film. Same partner. Same creative territory.</p>
      <div class="mf-cta__actions">
        <a class="contact__cta contact__cta--primary" href="/#brief">
          Start a moodfilm
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a class="contact__cta contact__cta--ghost" href="mailto:hello@moodwalkrs.com?subject=Moodfilm%20inquiry">Email us</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* ===== Page shell ===== */
  .moodfilm-page {
    padding: 140px var(--pad-x) 80px;
    max-width: 1080px;
    margin: 0 auto;
  }

  /* ===== Intro (sober, smaller) ===== */
  .mf-intro {
    text-align: center;
    margin-bottom: 100px;
  }
  .mf-intro__title {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 132px);
    line-height: .92;
    letter-spacing: -.04em;
    text-transform: uppercase;
    margin: 18px 0 36px;
  }
  .mf-intro__title .punct { color: var(--acid); }
  .mf-intro__body {
    max-width: 64ch;
    margin: 0 auto;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }
  .mf-intro__lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 18px;
  }
  .mf-intro__lead strong { color: var(--acid); font-weight: 600; }
  .mf-intro__sub {
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  /* ===== Case study container ===== */
  .mf-case {
    padding-top: 80px;
    border-top: 1px solid var(--line);
  }
  .mf-case__head {
    margin-bottom: 60px;
    max-width: 60ch;
  }
  .mf-case__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 60px);
    line-height: .98;
    letter-spacing: -.02em;
    text-transform: uppercase;
    margin: 12px 0 16px;
  }
  .mf-case__lead {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    max-width: 60ch;
    margin: 0;
  }

  /* ===== Reusable block (brief / clips / credits) ===== */
  .mf-block {
    margin: 0 0 80px;
  }
  .mf-block:last-child { margin-bottom: 0; }
  .mf-block__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .25em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .mf-block__media {
    margin: 0 0 24px;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 14px 40px rgba(0,0,0,.45);
  }
  .mf-block__media img {
    display: block; width: 100%; height: auto;
  }
  .mf-block__copy {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 64ch;
    margin: 0;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }

  /* ===== 3 clips row ===== */
  .mf-clips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 4px;
  }
  .mf-clip {
    margin: 0;
    background: var(--bg-2);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .mf-clip__num {
    position: absolute; top: 12px; left: 14px; z-index: 2;
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .22em;
    color: var(--acid); text-transform: uppercase;
  }
  .mf-clip video {
    display: block; width: 100%; aspect-ratio: 16/9;
    object-fit: cover; background: #000;
  }
  .mf-clip figcaption {
    padding: 16px 18px 20px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }

  @media (max-width: 800px) {
    .mf-clips { grid-template-columns: 1fr; }
  }

  /* ===== Credits ===== */
  .mf-block--credits {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .mf-credits {
    margin: 0;
    display: flex; flex-direction: column; gap: 12px;
  }
  .mf-credits div {
    display: grid; grid-template-columns: 90px 1fr; gap: 14px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .2em;
    text-transform: uppercase;
  }
  .mf-credits dt { color: var(--muted); margin: 0; }
  .mf-credits dd { color: var(--fg); margin: 0; }
  .mf-block--credits .mf-block__copy { padding-top: 4px; }

  @media (max-width: 720px) {
    .mf-block--credits { grid-template-columns: 1fr; gap: 24px; }
  }

  /* ===== CTA ===== */
  .mf-cta {
    margin-top: 100px;
    padding: 80px var(--pad-x) 60px;
    margin-left: calc(var(--pad-x) * -1);
    margin-right: calc(var(--pad-x) * -1);
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .mf-cta__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 64px);
    line-height: .95;
    letter-spacing: -.02em;
    text-transform: uppercase;
    margin: 0 0 18px;
  }
  .mf-cta__title em { font-style: normal; color: var(--acid); }
  .mf-cta__sub {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    max-width: 56ch;
    margin: 0 auto 32px;
  }
  .mf-cta__actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>
