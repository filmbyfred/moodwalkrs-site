---
import BaseLayout from '../layouts/BaseLayout.astro';

import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Statement from '../components/Statement.astro';
import Manifesto from '../components/Manifesto.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Capabilities from '../components/Capabilities.astro';
import UseCases from '../components/UseCases.astro';
import Crew from '../components/Crew.astro';
import Clients from '../components/Clients.astro';
import Awards from '../components/Awards.astro';
import Contact from '../components/Contact.astro';

import homeData from '../../content/home/home.json';

const blocks = homeData.blocks as any[];
---

<BaseLayout
  title="Moodwalkrs — AI Creative Studio · Paris · Quality Driven"
  description="Moodwalkrs is an AI creative studio based in Paris. A collective of producers, directors, art directors and AI / VFX experts. We create, produce and accelerate premium visuals for brands, agencies and productions — without sacrificing taste or intention."
  keywords="AI creative studio, studio IA, AI VFX, AI film production, generative video, AI commercials, Paris creative studio, premium AI content, hyper-real AI, Moodwalkrs"
>
  {blocks.map((block) => {
    switch (block._template) {
      case 'hero':
        return (
          <Hero
            wordmark={block.wordmark}
            tagline={block.tagline}
            desc={block.desc}
            cta={block.cta}
            meta={block.meta}
          />
        );

      case 'marquee':
        return <Marquee words={block.words} reverse={block.reverse} />;

      case 'statement':
        return <Statement text={block.text} align={block.align} size={block.size} />;

      case 'manifesto':
        return (
          <Manifesto
            kicker={block.kicker}
            kickerRight={block.kickerRight}
            text={block.text}
            quote={block.quote}
            metaLeft={block.metaLeft}
            metaRight={block.metaRight}
          />
        );

      case 'work_grid':
        return (
          <WorkGrid
            label={block.label}
            title={block.title}
            rightMeta={block.rightMeta}
            slugs={block.slugs}
            allLink={block.allLink}
          />
        );

      case 'capabilities':
        return (
          <Capabilities
            label={block.label}
            title={block.title}
            rightMeta={block.rightMeta}
            items={block.items}
          />
        );

      case 'use_cases':
        return (
          <UseCases
            label={block.label}
            title={block.title}
            items={block.items}
            reassurance={block.reassurance}
          />
        );

      case 'crew':
        return (
          <Crew
            label={block.label}
            title={block.title}
            intro={block.intro}
            stats={block.stats}
            foundersLabel={block.foundersLabel}
            founders={block.founders}
            rolesLabel={block.rolesLabel}
            roles={block.roles}
            closing={block.closing}
          />
        );

      case 'clients':
        return <Clients names={block.names} />;

      case 'awards':
        return <Awards label={block.label} title={block.title} items={block.items} />;

      case 'contact':
        return (
          <Contact
            kicker={block.kicker}
            title={block.title}
            email={block.email}
            sub={block.sub}
            cta={block.cta}
            ctas={block.ctas}
            form={block.form}
          />
        );

      default:
        return null;
    }
  })}
</BaseLayout>
